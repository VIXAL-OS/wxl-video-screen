+++ b/FilmWorker.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <windows.h>
+#include <cwchar>
+#include <string>
+
+inline std::wstring filmName(const wchar_t* part, DWORD child) {
+    return L"Local\\WxlFilm-" + std::to_wstring(child) + L"-" + part;
+}
+inline HANDLE filmLifetime = nullptr;
+inline bool filmOpenLifetime(const wchar_t* args) {
+    // The owner creates this event before launch and signals it even on an immediate close.
+    const wchar_t* value = args ? wcsstr(args, L"--lifetime ") : nullptr;
+    if (!value) return false;
+    value += 11;
+    std::wstring suffix(value, wcscspn(value, L" \t"));
+    if (suffix.empty() || suffix.size() > 64 || suffix.find_first_not_of(L"0123456789-") != suffix.npos)
+        return false;
+    filmLifetime = OpenEventW(SYNCHRONIZE, FALSE, (L"Local\\WxlFilm-Life-" + suffix).c_str());
+    return filmLifetime && WaitForSingleObject(filmLifetime, 0) == WAIT_TIMEOUT;
+}
+inline bool filmStopping() {
+    return WaitForSingleObject(filmLifetime, 0) != WAIT_TIMEOUT;
+}
